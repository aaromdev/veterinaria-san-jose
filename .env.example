# Variables de entorno necesarias para el frontend.
# Copia este archivo a .env y completa los valores con tus credenciales de Supabase.
#
#   cp .env.example .env
#
# En producción (GitHub Pages) estas variables se inyectan en el build
# desde los secrets del repositorio (ver .github/workflows/deploy.yml).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY